# Stage 1: Build the Client
FROM node:26.12.1-alpine AS build

# Install Python, build dependencies and Canvas dependencies
RUN apk add --no-cache \
    python3 \
    make \
    g++ \
    pkgconfig \
    cairo-dev \
    pango-dev \
    libjpeg-turbo-dev \
    giflib-dev \
    librsvg-dev \
    pixman-dev

# Set working directory
WORKDIR /app

# Copy the MDposit-client source code
COPY MDposit-client ./MDposit-client

# Define working directory
WORKDIR /app/MDposit-client

# If there is a node host configuration file (client/host-config.js) then the client uses it instead of its default one
# The client takes it from host-config.js at its repository root
# The wildcard makes host-config.js optional (COPY only fails when none of its sources exist)
COPY Dockerfile.dev host-config.j[s] /app/context/
RUN if [ -f /app/context/host-config.js ]; then cp /app/context/host-config.js host-config.js; fi

# Node specific images (client/images/), which host-config.js imports from 'src/images/untracked/...'
# Dockerfile.dev is copied only so that COPY does not fail when there is no images folder
COPY Dockerfile.dev image[s] /app/node-images/
RUN rm /app/node-images/Dockerfile.dev && mkdir -p src/images/untracked && cp -r /app/node-images/. src/images/untracked/

# Create .env file
RUN touch .env

# Install packages
RUN npm ci

# Build website
RUN npm run build

# Stage 2: Serve the client app with nginx
FROM docker.io/library/nginx:alpine

# Upgrade the base image system packages to get security fixes (e.g. brotli, openssl)
# 'apk add' alone does not upgrade packages already present in the base image
RUN apk upgrade --no-cache

# Define the build arguments
ARG CLIENT_INNER_PORT

# Define working dir
WORKDIR /app

# Set version to dev
RUN echo "dev" > version.txt

# Copy from the previous stage
COPY --from=build /app/MDposit-client/build /usr/share/nginx/html

# Publish the version so that vre_lite's status page can ask the running client for it
RUN cp /app/version.txt /usr/share/nginx/html/version.txt

# Expose port ${CLIENT_INNER_PORT}
EXPOSE ${CLIENT_INNER_PORT}

# Start nginx
CMD ["nginx", "-g", "daemon off;"]