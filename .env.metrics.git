# Metrics extension variables (extensions/grafana.yml and extensions/metrics.yml).
# Copy these into the root .env (alongside the core and other extension variables)
# and adjust the values for your deployment.

# ---------------------------
# Grafana OAuth - Google
# ---------------------------
# https://grafana.com/docs/grafana/latest/setup-grafana/configure-access/configure-authentication/google/
GF_AUTH_GOOGLE_ENABLED=false
GF_AUTH_GOOGLE_CLIENT_ID=
GF_AUTH_GOOGLE_CLIENT_SECRET=
# Comma-separated domains allowed to sign in, e.g. mddbr.eu,irbbarcelona.org
GF_AUTH_GOOGLE_ALLOWED_DOMAINS=
GF_ADMIN_MAIL=
# ---------------------------
# Grafana SMTP
# ---------------------------
# Set GF_SMTP_ENABLED=true and fill in the mail server details to allow alerts and
# notification test emails to be sent from Grafana.
# https://tasrieit.com/blog/where-to-setup-grafana-smtp-settings-complete-guide
GF_SMTP_ENABLED=false
# Example: smtp.example.com:587
GF_SMTP_HOST=
GF_SMTP_USER=
GF_SMTP_PASSWORD=
GF_SMTP_FROM_ADDRESS=
GF_SMTP_FROM_NAME=

# ---------------------------
# Prometheus
# ---------------------------
# "remote" = per-node Prometheus that remote_writes to the central backend.
# "local"  = act as the central Prometheus backend (set this on the monitoring host).
PROMETHEUS_MODE=remote
# Optional blackbox exporter (HTTP endpoint probing). 0 = not deployed, 1 = deployed.
BLACKBOX_REPLICAS=0
# remote mode only: the central Prometheus remote_write endpoint the node pushes to.
# Point it at the central host's HTTPS receiver (proxied by Apache to Prometheus).
# Defaults to http://monitoring-central:9090/api/v1/write if left unset.
PROM_URL=https://central.mddbr.eu/prometheus/api/v1/write
# remote_write basic_auth credentials.
#   PROM_USER - username; sent by nodes (remote mode) and validated by Apache on the central host.
#   PROM_PASS - plaintext password; sent by nodes and used by Apache to generate its htpasswd file.
# Avoid | & \ / in both values (a long alphanumeric password is safest).
PROM_USER=
PROM_PASS=